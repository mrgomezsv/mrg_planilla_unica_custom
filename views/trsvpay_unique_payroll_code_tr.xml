<odoo>
    <record model="ir.ui.view" id="trsvpay_unique_payroll_code_tr_tree">
        <field name="name">trsvpay.unique.payroll.code.tr.tree</field>
        <field name="model">trsvpay.unique.payroll.code.tr</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="trsvpay_unique_payroll_code_tr_action">
        <field name="name">Códigos de Planilla Única</field>
        <field name="res_model">trsvpay.unique.payroll.code.tr</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Crear un nuevo código</p>
        </field>
    </record>

    <menuitem id="trsvpay_unique_payroll_code_tr_menu" action="trsvpay_unique_payroll_code_tr_action"
              parent="hr_work_entry_contract_enterprise.menu_hr_payroll_configuration"
              sequence="30"/>
</odoo>
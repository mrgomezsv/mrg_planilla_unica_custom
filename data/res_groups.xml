<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acceso a Código de Planillas manejado en security/ir.access.csv -->
    <data>
        <!-- Hacemos que todos los usuarios internos hereden el grupo de Planillas Especiales automáticamente -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('treming_sv_payroll.group_special_payroll_tr'))]"/>
        </record>

        <!-- Habilitamos el botón de Crear en la vista Form de hr.planilla -->
        <record id="view_form_hr_planilla_custom_create" model="ir.ui.view">
            <field name="name">hr.planilla.form.custom.create</field>
            <field name="model">hr.planilla</field>
            <field name="inherit_id" ref="treming_sv_payroll.view_form_hr_planilla"/>
            <field name="arch" type="xml">
                <form position="attributes">
                    <attribute name="create">1</attribute>
                </form>
            </field>
        </record>

        <!-- Habilitamos el botón de Crear en la vista Tree/List de hr.planilla -->
        <record id="view_tree_hr_planilla_custom_create" model="ir.ui.view">
            <field name="name">hr.planilla.tree.custom.create</field>
            <field name="model">hr.planilla</field>
            <field name="inherit_id" ref="treming_sv_payroll.view_tree_hr_planilla"/>
            <field name="arch" type="xml">
                <xpath expr="/*" position="attributes">
                    <attribute name="create">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Liberamos el campo 'special_type_tr_id' en el wizard (Generar Planillas) -->
        <record id="hr_payslip_employees_form_custom_free" model="ir.ui.view">
            <field name="name">hr.payslip.employees.form.custom.free</field>
            <field name="model">hr.payslip.employees</field>
            <field name="inherit_id" ref="treming_sv_payroll.hr_payslip_employees_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='special_type_tr_id']" position="attributes">
                    <attribute name="groups"></attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
